---
interface Props {
  categories: any;
  executives: any;
}

const { categories, executives } = Astro.props;
const cmsDataJson = JSON.stringify({ categories, executives });
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CMS Battle — 13 CMS Platforms, 110 Features, 24 Categories</title>
<meta name="description" content="In-depth comparison of 13 CMS platforms: Craft CMS, Directus, Drupal, Ghost, Joomla, KeystoneJS, October CMS, Payload, Strapi, Sulu, TYPO3, Wagtail, WordPress. 110 features, verified data, interactive picker.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<script is:inline>
  // Apply saved theme immediately to prevent flash
  if (localStorage.getItem('cms-theme') === 'dark') {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
</script>
</head>
<body x-data x-bind:data-theme="$store.theme.mode === 'dark' ? 'dark' : null">

<button class="theme-toggle" @click="$store.theme.toggle()">
  <span class="toggle-icon" x-html="$store.theme.mode === 'dark' ? '&#9788;' : '&#9790;'"></span>
  <span x-text="$store.theme.mode === 'dark' ? 'light' : 'dark'"></span>
</button>

<slot />

<script is:inline define:vars={{ cmsDataJson }}>
window.CMS_DATA = JSON.parse(cmsDataJson);
</script>
<script is:inline src="/js/qfd-scoring.js"></script>
<script is:inline src="/js/app.js"></script>
<script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</body>
</html>
